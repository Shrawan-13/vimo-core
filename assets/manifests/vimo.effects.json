{
  "manifest_version": 1,
  "effects": [
    {
      "id": "com.vimo.effect.brightness",
      "name": "Brightness",
      "category": "color",
      "version": 1,
      "shader": "vimo/shaders/brightness.frag",
      "params": [
        { "name": "amount", "type": "float", "default": 0.0, "min": -1.0, "max": 1.0, "label": "Brightness" }
      ]
    },
    {
      "id": "com.vimo.effect.contrast",
      "name": "Contrast",
      "category": "color",
      "version": 1,
      "shader": "vimo/shaders/contrast.frag",
      "params": [
        { "name": "amount", "type": "float", "default": 1.0, "min": 0.0, "max": 3.0, "label": "Contrast" }
      ]
    },
    {
      "id": "com.vimo.effect.saturation",
      "name": "Saturation",
      "category": "color",
      "version": 1,
      "shader": "vimo/shaders/saturation.frag",
      "params": [
        { "name": "amount", "type": "float", "default": 1.0, "min": 0.0, "max": 3.0, "label": "Saturation" }
      ]
    },
    {
      "id": "com.vimo.effect.temperature",
      "name": "Temperature",
      "category": "color",
      "version": 1,
      "shader": "vimo/shaders/temperature.frag",
      "params": [
        { "name": "amount", "type": "float", "default": 0.0, "min": -1.0, "max": 1.0, "label": "Temperature" }
      ]
    },
    {
      "id": "com.vimo.effect.tint",
      "name": "Tint",
      "category": "color",
      "version": 1,
      "shader": "vimo/shaders/tint.frag",
      "params": [
        { "name": "color", "type": "color", "default": "#ffffffff", "label": "Color" }
      ]
    },
    {
      "id": "com.vimo.effect.vignette",
      "name": "Vignette",
      "category": "style",
      "version": 1,
      "shader": "vimo/shaders/vignette.frag",
      "params": [
        { "name": "amount", "type": "float", "default": 0.4, "min": 0.0, "max": 1.0, "label": "Amount" },
        { "name": "radius", "type": "float", "default": 0.7, "min": 0.1, "max": 1.5, "label": "Radius" }
      ]
    },
    {
      "id": "com.vimo.effect.sharpen",
      "name": "Sharpen",
      "category": "detail",
      "version": 1,
      "shader": "vimo/shaders/sharpen.frag",
      "params": [
        { "name": "amount", "type": "float", "default": 0.5, "min": 0.0, "max": 3.0, "label": "Amount" }
      ]
    },
    {
      "id": "com.vimo.effect.blur",
      "name": "Blur",
      "category": "blur",
      "version": 1,
      "shader": "vimo/shaders/blur.frag",
      "params": [
        { "name": "radius", "type": "float", "default": 4.0, "min": 0.0, "max": 32.0, "label": "Radius" }
      ]
    }
  ]
}
